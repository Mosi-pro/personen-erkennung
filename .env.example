# MOSI INTEL – Konfiguration. Kopie als .env speichern (install.sh erledigt das automatisch).

# --- Netzwerk ---
# Port, unter dem MOSI INTEL erreichbar ist
MOSI_PORT=8080
# Bind-Adresse: LAN-IP des Servers (z. B. 192.168.1.50) für Zugriff im lokalen Netz,
# 127.0.0.1 = nur der Server selbst. NIEMALS 0.0.0.0, wenn der Server aus dem Internet erreichbar ist.
MOSI_BIND=127.0.0.1
# Zusätzlich blockiert die App Zugriffe von öffentlichen IP-Adressen (nur auf true setzen, wenn du das bewusst willst)
MOSI_ALLOW_PUBLIC=false
# true, sobald du MOSI INTEL hinter einem HTTPS-Reverse-Proxy betreibst
MOSI_COOKIE_SECURE=false

# --- Login (nur beim allerersten Start verwendet) ---
MOSI_ADMIN_USER=admin
# Leer lassen = zufälliges Passwort wird erzeugt und ins Log geschrieben. install.sh setzt ein Passwort.
MOSI_ADMIN_PASSWORD=

# --- Kontakt für User-Agent (Wikipedia/OpenStreetMap verlangen das) ---
# Eigene URL oder E-Mail eintragen, falls Wikipedia „Zugriff verweigert“ meldet
MOSI_CONTACT=https://github.com/mosi-pro/personen-erkennung

# --- Limits ---
MOSI_MAX_UPLOAD_MB=10
MOSI_SESSION_HOURS=12

# --- Suchanbieter (alternativ in den Settings der Oberfläche eintragbar) ---
# Kostenlos & selbst gehostet: SearXNG (docker compose --profile searxng up -d)
SEARXNG_URL=
# Optional: Brave Search API (kostenloses Kontingent) – https://brave.com/search/api/
BRAVE_API_KEY=

# --- SearXNG (nur mit Profil "searxng") ---
COMPOSE_PROFILES=
SEARXNG_SECRET=change-me-please

# --- Build ---
# 0 = ohne Tesseract-OCR bauen (spart ~100 MB, dann keine Textauswertung in Bildern)
INSTALL_OCR=1
